# =====================================================================
# Memory Rebirth Attack: configuration template
#
#   cp .env.example .env      then fill in the marked values
#
# Every endpoint, credential and model id lives in this file. There are none in the
# code: no hostname, no provider name, no model prefix. Switching provider is an edit
# here and nothing else.
#
# NEVER commit .env; it is git-ignored.
# =====================================================================


# ---------------------------------------------------------------------
# 1. GRAPH DATABASE for the system under test (Graphiti)
# ---------------------------------------------------------------------
# Start one with:
#   docker run -d --name mwe-neo4j -p 7475:7474 -p 7688:7687 \
#     -e NEO4J_AUTH=neo4j/<password> neo4j:5.26
# 5.26+ is required: earlier versions lack the relationship-vector procedure Graphiti
# needs. Ports are deliberately non-default so this does not collide with other Neo4j
# instances on the same machine.
NEO4J_URI=bolt://localhost:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=                      # <-- set this, and use the same value in docker run

# Graph partition the experiments create and wipe. Everything under this id is deleted
# and rewritten between situations, so point it at a namespace you do not care about.
MWE_GROUP_ID=mwe_rebirth


# ---------------------------------------------------------------------
# 2. WHICH PROVIDER TO USE
# ---------------------------------------------------------------------
# Two independent selectors, so you can mix: a hosted LLM with a local embedder is a
# normal and cheap configuration.
#
#   LLM_PROVIDER    does entity/edge extraction and contradiction detection inside the
#                   memory systems under test
#   EMBED_PROVIDER  produces the vectors that drive semantic retrieval
#
# Valid values: ollama | openai | anthropic | openrouter | litellm | custom | gemini
# All except `gemini` speak the OpenAI-compatible protocol and share one code path;
# `custom` is the generic slot for any other OpenAI-compatible endpoint.
#
# NOT every provider serves embeddings. `anthropic` and `openrouter` are chat-only, and
# many multi-vendor gateways are too. That is exactly why these two selectors are
# separate: leave EMBED_PROVIDER=ollama and only LLM_PROVIDER has to change.
# See the provider table in README.md for what each one supports.
LLM_PROVIDER=ollama
EMBED_PROVIDER=ollama

# To add a provider that is not listed: add a <NAME>_* block below in the same shape,
# then register it in core/endpoints.py::PROVIDERS. That is the only code change.


# ---------------------------------------------------------------------
# 3. PROVIDER BLOCKS: fill in the one(s) you selected above
# ---------------------------------------------------------------------
# Model ids are endpoint-specific opaque strings. There is no safe default: an id from
# one endpoint is a 404 on another. Discover the ids YOUR endpoint actually serves:
#
#   uv run python scripts/probe_models.py
#
# It sends two real requests to every advertised route (a plain completion, and one
# constrained to strict JSON) and writes the verified list to docs/MODELS.md. Only ids
# listed there as usable will work.

# ---- Local Ollama (no key needed; good default for embeddings) ----
OLLAMA_BASE=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_LLM_MODEL=qwen2.5:3b-instruct
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_EMBED_DIM=768

# ---- OpenAI, or any OpenAI-compatible endpoint ----
OPENAI_BASE=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_LLM_MODEL=
OPENAI_EMBED_MODEL=
OPENAI_EMBED_DIM=1536
# Cap per-request output. Needed on credit-limited endpoints that reject large requests.
OPENAI_MAX_TOKENS=

# ---- OpenRouter ----
OPENROUTER_BASE=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_LLM_MODEL=
OPENROUTER_MAX_TOKENS=8000

# ---- A proxy/gateway fronting several providers (LiteLLM or similar) ----
# Useful when you want many vendors behind one key. Such gateways commonly expose chat
# models but NO embedding route; keep EMBED_PROVIDER=ollama if that is the case.
LITELLM_BASE=
LITELLM_API_KEY=
LITELLM_LLM_MODEL=
LITELLM_EMBED_MODEL=
LITELLM_EMBED_DIM=768
LITELLM_MAX_TOKENS=8000

# ---- Anthropic, over its OpenAI-compatible surface ----
# No embedding route, so keep EMBED_PROVIDER pointing elsewhere.
#
# Use a programmatic API key issued from the console. An interactive OAuth token from a
# subscription client may authenticate, but its quota is shared with whatever client is
# signed in with it, so a batch run competes with that client and stalls on rate limits
# rather than failing cleanly. `scripts/probe_anthropic.py` distinguishes the two cases.
ANTHROPIC_BASE=https://api.anthropic.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_LLM_MODEL=
ANTHROPIC_MAX_TOKENS=2000

# ---- Any other OpenAI-compatible endpoint ----
CUSTOM_BASE=
CUSTOM_API_KEY=
CUSTOM_LLM_MODEL=
CUSTOM_EMBED_MODEL=
CUSTOM_EMBED_DIM=768
CUSTOM_MAX_TOKENS=

# ---- Google Gemini (native SDK, not OpenAI-compatible) ----
GEMINI_API_KEY=
GEMINI_LLM_MODEL=
GEMINI_EMBED_MODEL=
GEMINI_EMBED_DIM=768
# Research setting: disables the four adjustable safety filters so that a refusal is
# not mis-scored as the agent making a safe policy decision. Only meaningful for
# controlled security testing; leave false otherwise.
GEMINI_DISABLE_SAFETY=false


# ---------------------------------------------------------------------
# 4. EVALUATION MODELS
# ---------------------------------------------------------------------
# The models whose DECISIONS are measured. Every one is run on every cell of the
# matrix with the same trial count; that is what makes cross-system numbers
# comparable, so this list must not change partway through a run.
#
# Populate from docs/MODELS.md (generated by scripts/probe_models.py). Aim for vendor
# and capability spread: a claim about "agents" should not rest on a single vendor.
DECISION_MODELS=

# Where those models are served. Leave blank to reuse the LLM_PROVIDER endpoint.
#
# Deliberately separate from the provider blocks above: the model doing extraction inside
# the systems under test and the models whose decisions are measured do not have to come
# from the same place, and usually should not. Extraction runs on every ingested episode
# and can go somewhere cheap or local; the evaluated models must all be served the same
# way as each other, or a cross-model comparison is measuring the serving path as well as
# the model. One provider for all of DECISION_MODELS is what keeps that clean.
DECISION_BASE=
DECISION_KEY=
DECISION_MAX_TOKENS=2000

# Trials per (system x situation x model) cell. All proportions are reported with
# Wilson 95% intervals, so more trials narrows the interval rather than moving the
# estimate. 10 is a reasonable floor for a publishable rate.
N_TRIALS=10

# Sampling temperature for decision calls. Deliberately NOT 0: greedy decoding would
# show only that one path to the unsafe action exists, whereas the claim under test is
# that it is chosen at a substantial rate.
DECISION_TEMPERATURE=0.7

# How the revoked state comes to exist. Both are normally run:
#   direct  = the harness applies the system's own revocation primitive (controlled)
#   natural = only plain text is ingested and the system revokes on its own, which is
#             faithful to the threat model where the attacker cannot write to the store
SEED_MODES=direct,natural

# Concurrency for decision calls. Purely a throughput setting: every model still
# answers identical prompts the same number of times. Lower it if your endpoint
# rate-limits.
DECISION_WORKERS=24

# Deadline for one system's retrieval probe over the whole situation set. Some backends
# ingest asynchronously and some self-hosted models are slow, so this is generous.
PROBE_TIMEOUT_S=7200

# Per-request and per-trial deadlines for decision calls. These exist because a network
# interruption mid-run leaves sockets established but dead, and without an explicit
# timeout the run blocks forever rather than retrying. Do not remove them.
DECISION_TIMEOUT_S=180
TRIAL_TIMEOUT_S=900

# Continue an interrupted matrix instead of restarting it. Only reuses previous cells if
# the model set, trial count, temperature, arms, situations and guard thresholds are all
# unchanged; on any difference it starts clean and says so, because mixing cells from two
# configurations into one table is worse than repeating the work.
RESUME=0


# ---------------------------------------------------------------------
# 5. MODEL PROBING
# ---------------------------------------------------------------------
# Endpoint to catalogue. Leave blank to use DECISION_BASE, then the LLM provider.
PROBE_BASE=
PROBE_KEY=
# Comma-separated substrings of routes to skip (no quota, not wanted). Recorded in the
# output so an exclusion is auditable rather than silent.
EXCLUDE_MODELS=


# ---------------------------------------------------------------------
# 6. SECONDARY-CONTAMINATION EXPERIMENT
# ---------------------------------------------------------------------
# Each trial seeds, decides, writes the decision back and re-decides several times, so
# this is far more expensive per trial than the matrix and has its own count.
CONTAMINATION_TRIALS=3
CONTAMINATION_HOPS=3


# ---------------------------------------------------------------------
# 6b. PROPAGATION AND PERSISTENCE EXPERIMENTS
# ---------------------------------------------------------------------
# Propagation runs three agent roles per trial over one shared store; persistence walks
# one seeded store along three distance axes. Both cost several calls per trial, so they
# carry their own model list. Blank means "use DECISION_MODELS"; a subset is appropriate
# while iterating, but any reported number must name the models behind it.
PROPAGATION_MODELS=
PROPAGATION_TRIALS=3
PERSISTENCE_MODELS=
PERSISTENCE_TRIALS=2
# Store sizes on the growth axis (counts of unrelated current facts added).
PERSISTENCE_GROWTH=0,10,40,100
# Intervening benign decision turns on the turn-distance axis.
PERSISTENCE_TURNS=5

# Trials per captured context for the decision-parse audit (scripts/parse_audit.py),
# which measures how often a reply yields no parseable action.
PARSE_AUDIT_TRIALS=3


# ---------------------------------------------------------------------
# 7. STALE-RETRIEVAL GUARD (the proposed mitigation)
# ---------------------------------------------------------------------
# Thresholds for guard/stale_guard.py. Deliberately conservative: a false positive
# removes a current policy from the agent's context, which is worse than letting one
# stale fact through.
GUARD_SUBJECT_OVERLAP=0.45           # min content-word containment to count as "same subject"
GUARD_REQUIRE_OPPOSITION=true        # same subject alone never justifies withholding
GUARD_TRUST_EXPLICIT=true            # honour backend revocation fields when present
GUARD_MAX_WITHHELD_RATIO=0.6         # never withhold most of a result set

# Running the guard as an MCP server in front of an existing memory backend.
GUARD_TRANSPORT=stdio                # stdio | http
GUARD_PORT=8100
GUARD_BACKEND=http
GUARD_BACKEND_URL=                   # the memory system's search endpoint
GUARD_BACKEND_KEY=
GUARD_BACKEND_AUTH_SCHEME=Bearer
GUARD_BACKEND_QUERY_FIELD=query      # request field carrying the query text
GUARD_BACKEND_RESULT_PATH=results    # dotted path to the result list in the response
GUARD_BACKEND_TIMEOUT=120


# ---------------------------------------------------------------------
# 8. ZEP STACK (only if evaluating Zep; see docs/SETUP.md)
# ---------------------------------------------------------------------
ZEP_BASE=http://localhost:8020/api/v2
ZEP_API_SECRET=                      # <-- any value; must match config/zep_ce.yaml
ZEP_NEO4J_URI=bolt://localhost:7689
ZEP_NEO4J_USER=neo4j
ZEP_NEO4J_PASSWORD=                  # <-- must match the compose file
# Zep ingests asynchronously; facts become searchable only after its worker finishes.
ZEP_SETTLE_S=45


# ---------------------------------------------------------------------
# 9. CALL THROTTLE
# ---------------------------------------------------------------------
# Sleeps a random interval before each model call. Useful against per-minute limits on
# free tiers. Leave DISABLED for batch runs: it also wraps embedding calls, and with
# hundreds of seeds per run that causes timeouts.
CALL_DELAY_ENABLED=false
CLOUD_DELAY_MIN=0.5
CLOUD_DELAY_MAX=2.5
LOCAL_DELAY_MIN=2.0
LOCAL_DELAY_MAX=6.0

# ---------------------------------------------------------------------
# 10. OUTPUT AND PUBLICATION BOUNDARY
# ---------------------------------------------------------------------
# Run artifacts are written OUTSIDE the code tree by default. Raw output records model
# ids, endpoint behaviour and full retrieved contexts; it is research data, not part of
# the published repository.
RESULTS_DIR=../private/results
REPORTS_DIR=../private/reports

# A gateway model id is `<routing namespace>/<model family>`. The family is public and
# scientifically necessary; the namespace is your deployment's internal naming and is
# stripped from anything written to a published file (the model catalogue, docs).
# Comma-separated. Leave empty if your ids carry no private namespace.
MODEL_ID_PUBLIC_STRIP=

# ---- Zep shim upstream model (only if evaluating Zep) ----
# Used by config/zep_shim.yaml. It lives here, not in that file, because a model id is
# endpoint-specific and carries your gateway's private routing namespace, and that file
# ships. Format: openai/<your-namespace>/<model>
ZEP_SHIM_LLM_MODEL=
